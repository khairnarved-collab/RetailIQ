# ============================================================================
# RetailIQ configuration - copy to .env and adjust. NEVER commit the real .env.
# ============================================================================

# --- Database -----------------------------------------------------------------
# PostgreSQL (recommended / production). Leave DATABASE_URL empty or commented
# out to use a zero-setup local SQLite file at data/retailiq.db instead.
DATABASE_URL=postgresql+psycopg://retailiq:retailiq@localhost:5432/retailiq
# Used by docker-compose for the PostgreSQL container:
POSTGRES_USER=retailiq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=retailiq

# --- Security -----------------------------------------------------------------
# Generate a long random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Development only: show password-reset tokens in the UI because no email server is set up.
# Set to false in production (and send reset links by email instead).
EXPOSE_RESET_TOKEN=true
ALLOW_PUBLIC_SIGNUP=true
# Public demo sites: stop visitors from changing/deleting the demo accounts
PROTECT_DEMO_ACCOUNTS=false
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Limits ---------------------------------------------------------------------
MAX_UPLOAD_MB=25
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_ASSISTANT_PER_MIN=30

# --- Optional: LLM explanations in the AI assistant ------------------------------
# Leave both empty to run the assistant in rule-based mode (fully functional).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Docker -----------------------------------------------------------------------
# Load demo users + synthetic sample data on first start
SEED_DEMO_DATA=true
LOG_LEVEL=INFO
ENVIRONMENT=development
